   "rdfs:label": "The Exodus",
   "skos:altLabel": [
    "Exodus from Egypt",
    "the deliverance from Egypt",
    "the departure from Egypt"
   ],
   "skos:broader": {
    "@id": "bg:the-story-of-the-bible"
   },
   "skos:definition": "God's deliverance of the Israelites from slavery in Egypt under Moses — through the plagues, the first Passover and the crossing of the sea — which became Israel's defining story of salvation and which the New Testament uses to explain the death and resurrection of Jesus.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/bible-graph/id/scheme/events-and-timeline"
   },
   "skos:prefLabel": "The Exodus",
