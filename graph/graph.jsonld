   "rdfs:label": "Lectio Divina",
   "skos:altLabel": [
    "divine reading",
    "lectio",
    "prayerful reading of Scripture",
    "reading meditation prayer contemplation",
    "sacred reading"
   ],
   "skos:broader": {
    "@id": "bg:prayer"
   },
   "skos:definition": "An ancient Christian way of reading a short passage of Scripture slowly and prayerfully, moving through reading (lectio), meditation (meditatio), prayer (oratio) and contemplation (contemplatio), and often on to action (actio), so that reading the Bible becomes a conversation with God.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/bible-graph/id/scheme/study-practices"
   },
   "skos:prefLabel": "Lectio Divina",
   "skos:related": [
    {
     "@id": "bg:biblical-interpretation"
