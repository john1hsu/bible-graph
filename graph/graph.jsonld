   ],
   "skos:broader": {
    "@id": "bg:covenant"
   },
   "skos:definition": "God's covenant with Abraham in Genesis 12-22, promising him descendants, the land of Canaan and blessing for all the families of the earth, sealed by a covenant rite in Genesis 15, given the sign of circumcision in Genesis 17 and confirmed by oath in Genesis 22; the New Testament reads it as fulfilled in Christ, and Christian traditions differ on how its promises to Israel and its sign carry forward.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/bible-graph/id/scheme/themes-and-theology"
   },
