   "rdfs:label": "Babylonian Exile",
   "skos:altLabel": [
    "Babylonian captivity",
    "Judean exile",
    "deportation to Babylon",
    "exile to Babylon",
    "the captivity",
    "the exile"
   ],
   "skos:broader": {
    "@id": "bg:the-story-of-the-bible"
   },
   "skos:definition": "The deportation of the people of Judah to Babylon by Nebuchadnezzar II in the early sixth century BC — in waves around 597 and 587/586 BC, with the burning of Jerusalem and Solomon's Temple — until Cyrus of Persia allowed exiles to return in 538 BC; the crisis that reshaped Israel's faith and much of the Old Testament.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/bible-graph/id/scheme/events-and-timeline"
   },
